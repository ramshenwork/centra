# Copy to shared/config/.env and fill in. The real .env is never committed.
APP_ENV=production                     # development | production
APP_BASE_URL=https://your-app.onrender.com
PUBLIC_DOMAIN_LABEL=centra.in          # text shown as the booking-link domain
SECRET_KEY=                            # long random string: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_HOURS=12
COOKIE_SECURE=true

# Supabase Postgres (use the connection string from Supabase > Project settings > Database)
DATABASE_URL=postgresql+psycopg://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Who gets alerts / is shown as the contact on lockouts
SUPPORT_EMAIL=ramshenwork@gmail.com
ALERT_EMAIL=ramshenwork@gmail.com

# Email (OTP codes, booking emails). console = development only.
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CENTRA <no-reply@yourdomain>
SMTP_STARTTLS=true

# Razorpay. mock = development only (refused in production).
PAYMENTS_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ROUTE_ENABLED=false                    # switch on only after Razorpay approves Route

# Logo storage. local = shared/data/uploads (wiped on Render redeploys). Use supabase on Render.
STORAGE_BACKEND=supabase
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=logos                  # create as a PUBLIC bucket

# Hourly reminder cron (POST /api/internal/send-reminders with header X-Cron-Secret)
CRON_SECRET=

BOOKING_HOLD_MINUTES=10
BOOKING_WINDOW_MONTHS=2
TIMEZONE=Asia/Kolkata
